# Inactive template. Enable with a credential that can publish workflows.
name: Documentation checks
on: [push, pull_request]
permissions:
  contents: read
jobs:
  docs:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
        with:
          persist-credentials: false
      - uses: actions/setup-python@v5
        with:
          python-version: '3.12'
      - run: python -m unittest discover -s tests -v
      # Syntax and local links only: never execute unreviewed PR code with secrets.
      - run: python docguard.py docs --annotations
